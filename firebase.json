{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "webmay-251244",
    "public": ".",
    "ignore": [
      "firebase.json",
      "docker-compose.yml",
      "Dockerfile",
      "nginx.conf",
      "package.json",
      "deploy.bat",
      "skills-lock.json",
      "**/.*",
      "**/node_modules/**",
      "backup_bangkok/**",
      ".vscode/**",
      ".agents/**",
      ".firebase/**",
      "**/*.md"
    ],
    "headers": [
      {
        "source": "**/*.@(css|js)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|svg|ico|woff2)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      }
    ]
  }
}
