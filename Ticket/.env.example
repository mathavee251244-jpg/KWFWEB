# ─── Server ────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── Synology NAS (ตั้งค่าเพื่อดูพื้นที่ NAS ในหน้า System Status) ──
# ใช้ http:// หรือ https:// ตาม DSM ของคุณ
# พอร์ตปกติ: http = 5000, https = 5001
NAS_URL=http://192.168.1.100:5000
NAS_USER=admin
NAS_PASS=your_nas_password
